# Set as environment variables (docker compose loads .env for Docker only).
AVENIQ_HOST=127.0.0.1
AVENIQ_PORT=8768
AVENIQ_DB=./data/aveniq.db
AVENIQ_PUBLIC_ORIGIN=http://127.0.0.1:8768

# Optional IMAP and SMTP credentials for configured account prefix.
AVENIQ_ACCOUNT_WORK_USER=
AVENIQ_ACCOUNT_WORK_PASSWORD=

# Optional read-only DAV credentials.
AVENIQ_CAL_TEAM_USER=
AVENIQ_CAL_TEAM_PASSWORD=

# Optional AI, globally and individually opt-in in UI before any request.
AVENIQ_OPENAI_API_KEY=
AVENIQ_OPENAI_MODEL=gpt-4.1-mini
